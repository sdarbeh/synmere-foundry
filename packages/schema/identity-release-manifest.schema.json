{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synmere.dev/identity-release-manifest/v1.json",
  "title": "Synmere Identity Shell Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetSchemaVersion",
    "assetId",
    "displayName",
    "version",
    "stage",
    "releaseTag",
    "url",
    "thumbnails",
    "defaultVariantId",
    "variants",
    "sha256",
    "meshName",
    "materialNames",
    "morphTargetNames",
    "topologyVersion",
    "rendererCompatibilityVersion",
    "minimumApplicationVersion",
    "validation",
    "releasedAt",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "assetSchemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "stage": {
      "enum": ["dev", "candidate", "production"]
    },
    "releaseTag": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "\\.glb$"
    },
    "thumbnails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thumbnail"
      }
    },
    "defaultVariantId": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "meshName": {
      "type": "string",
      "minLength": 1
    },
    "materialNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "morphTargetNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "topologyVersion": {
      "type": "string",
      "minLength": 1
    },
    "rendererCompatibilityVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minimumApplicationVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "localRegression",
        "globalAssetSafety",
        "productionPath",
        "sampledMorphStates",
        "invertedStates",
        "degenerateStates"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "localRegression": {
          "const": true
        },
        "globalAssetSafety": {
          "const": true
        },
        "productionPath": {
          "const": true
        },
        "sampledMorphStates": {
          "type": "integer",
          "minimum": 1
        },
        "invertedStates": {
          "const": 0
        },
        "degenerateStates": {
          "const": 0
        }
      }
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "candidate"],
      "oneOf": [
        { "required": ["blendSha256"] },
        { "required": ["artifact"] }
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "blendSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "filename", "sha256", "tracked"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "filename": { "type": "string", "minLength": 1 },
            "localPath": { "type": "string", "minLength": 1 },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "tracked": { "type": "boolean" }
          }
        }
      }
    },
    "releaseMetadata": {
      "type": "object"
    }
  },
  "$defs": {
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "source",
        "path",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["blender-render", "three-render", "placeholder", "manual"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "publicPath": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "isPlaceholder": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "thumbnails",
        "presentation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "thumbnails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/thumbnail"
          }
        },
        "presentation": {
          "oneOf": [
            {
              "$ref": "#/$defs/parameterPresetPresentation"
            },
            {
              "$ref": "#/$defs/glbPresentation"
            }
          ]
        }
      }
    },
    "parameterPresetPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameterPresetId"],
      "properties": {
        "type": {
          "const": "parameter-preset"
        },
        "parameterPresetId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "glbPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "glb"],
      "properties": {
        "type": {
          "const": "glb"
        },
        "glb": {
          "$ref": "#/$defs/glbArtifact"
        },
        "modulePublicPath": {
          "type": "string",
          "pattern": "^/(?!/)"
        }
      }
    },
    "glbArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicPath", "sha256", "sizeBytes"],
      "properties": {
        "publicPath": {
          "type": "string",
          "pattern": "^/(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
